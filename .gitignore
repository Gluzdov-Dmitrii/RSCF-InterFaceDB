# Existing local source packages. They contain large and potentially restricted files.
/Тексты заявки РНФ/
/МУНТ ЦНФМ/

# Private inventories and working notes.
/private/
*.local.*

# Full texts and generated literature corpora.
/literature/fulltext/*
!/literature/fulltext/README.md
/literature/searches/runs/*
!/literature/searches/runs/README.md
/literature/extraction/generated/

# Data and database artifacts. Track schemas, manifests and small fixtures only.
/data/external/*
/data/raw/*
/data/interim/*
/data/processed/*
/data/curated/*
!/data/external/.gitkeep
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep
!/data/curated/.gitkeep
*.sqlite
*.sqlite3
*.db
*.duckdb
*.parquet
*.feather
*.arrow

# Models, simulations and HPC outputs.
/models/*
!/models/README.md
/workflows/runs/
/simulations/runs/
*.ckpt
*.pt
*.pth
*.onnx
*.xtc
*.trr
*.dcd
*.lammpstrj
*.restart
*.wfn
*.cube

# Generated reports and manuscripts.
/reports/figures/generated/*
!/reports/figures/generated/.gitkeep
/reports/tables/generated/*
!/reports/tables/generated/.gitkeep
/manuscripts/**/build/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz

# Binary documents and archives should not enter Git accidentally.
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.zip
*.7z
*.tar
*.gz

# Python, notebooks and tools.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.ipynb_checkpoints/

# DVC local state and credentials. DVC pointer/config files remain trackable.
/.dvc/cache/
/.dvc/tmp/
/.dvc/config.local

# Secrets and temporary files.
.env
.env.*
!.env.example
/tmp/
/scratch/
*.log
.DS_Store
Thumbs.db
